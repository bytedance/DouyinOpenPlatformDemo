platform :ios, '15.0'

target 'DouyinOpenSDKDemo' do
  if ENV['DOUYIN_OPEN_SDK_PATH']
    pod 'DouyinOpenSDK', :path => ENV['DOUYIN_OPEN_SDK_PATH']
  else
    pod 'DouyinOpenSDK'
  end
  pod 'BDTDebugBox', :path => ENV.fetch('BDT_DEBUG_BOX_PATH', 'LocalSpecs/BDTDebugBox')
  pod 'QBImagePickerController'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      unless ENV['DOUYIN_OPEN_SDK_PATH'] && ENV['BDT_DEBUG_BOX_PATH']
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      end
    end
  end

  unless ENV['BDT_DEBUG_BOX_PATH']
    script_path = './install.sh'
    system("bash", "-c", "chmod +x #{script_path} && #{script_path}")
  end

end
